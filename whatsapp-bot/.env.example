# Copy to .env for local use; on Render set these in the service's Environment tab.
GROQ_API_KEY=
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
VERIFY_TOKEN=
# Required. The bot refuses to start without it.
APP_SECRET=
# C3SA staff number, international format without "+", e.g. 27XXXXXXXXX
STAFF_WHATSAPP=
# Optional but recommended. WhatsApp only delivers plain text to a number that
# messaged the bot in the last 24 hours. Create an approved template with ONE
# body variable (the learner's number) in Meta Business Manager and put its
# name here so staff are always reachable.
STAFF_TEMPLATE_NAME=
STAFF_TEMPLATE_LANG=en
PORT=3000
# Local testing only. Never set this in production.
# ALLOW_UNSIGNED_WEBHOOKS=true
